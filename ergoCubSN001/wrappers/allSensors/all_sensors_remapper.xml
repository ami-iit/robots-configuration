<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE devices PUBLIC "-//YARP//DTD yarprobotinterface 3.0//EN" "http://www.yarp.it/DTD/yarprobotinterfaceV3.0.dtd">


    <device xmlns:xi="http://www.w3.org/2001/XInclude" name="all_sensors_remapper" type="multipleanalogsensorsremapper">
        <!-- The below parameter names are set from the macro MAS_getTagFromEnum(enum MAS_SensorType) + "Names"
             defined in <yarp/dev/MultipleAnalogSensorsInterfaces.h> and respective device source file -->
        <param name="SixAxisForceTorqueSensorsNames">
            (l_arm_ft, r_arm_ft, l_foot_rear_ft, l_foot_front_ft, r_foot_rear_ft, r_foot_front_ft)
        </param>
        <param name="ThreeAxisGyroscopesNames">
            (waist_imu_0, l_arm_ft_imu, r_arm_ft_imu, l_foot_front_ft_imu, l_foot_rear_ft_imu, r_foot_front_ft_imu, r_foot_rear_ft_imu)
        </param>
        <param name="ThreeAxisLinearAccelerometersNames">
            (waist_imu_0, l_arm_ft_imu, r_arm_ft_imu, l_foot_front_ft_imu, l_foot_rear_ft_imu, r_foot_front_ft_imu, r_foot_rear_ft_imu)
        </param>
        <param name="ThreeAxisMagnetometersNames">
            (waist_imu_0, l_arm_ft_imu, r_arm_ft_imu, l_foot_front_ft_imu, l_foot_rear_ft_imu, r_foot_front_ft_imu, r_foot_rear_ft_imu)
        </param>
        <param name="OrientationSensorsNames">
            (waist_imu_0, l_arm_ft_imu, r_arm_ft_imu, l_foot_front_ft_imu, l_foot_rear_ft_imu, r_foot_front_ft_imu, r_foot_rear_ft_imu)
        </param>
        <action phase="startup" level="5" type="attach">
            <paramlist name="networks">
                <elem name="waist-inertial">  waist-inertial </elem>
                <elem name="left_arm-eb2-j0_1-strain">     left_arm-eb2-j0_1-strain      </elem>
                <elem name="left_arm-eb2-j0_1-inertial">   left_arm-eb2-j0_1-inertial    </elem>
                <elem name="right_arm-eb1-j0_1-strain">    right_arm-eb1-j0_1-strain     </elem>
                <elem name="right_arm-eb1-j0_1-inertial">  right_arm-eb1-j0_1-inertial   </elem>
                <elem name="left_leg-eb8-j0_3-strain">    left_leg-eb8-j0_3-strain    </elem>
                <elem name="left_leg-eb9-j4_5-strain">    left_leg-eb9-j4_5-strain    </elem>
                <elem name="left_leg-eb8-j0_3-inertial">  left_leg-eb8-j0_3-inertial  </elem>
                <elem name="left_leg-eb9-j4_5-inertial">  left_leg-eb9-j4_5-inertial  </elem>
                <elem name="right_leg-eb6-j0_3-strain">    right_leg-eb6-j0_3-strain    </elem>
                <elem name="right_leg-eb7-j4_5-strain">    right_leg-eb7-j4_5-strain    </elem>
                <elem name="right_leg-eb6-j0_3-inertial">  right_leg-eb6-j0_3-inertial  </elem>
                <elem name="right_leg-eb7-j4_5-inertial">  right_leg-eb7-j4_5-inertial  </elem>
            </paramlist>
        </action>

        <action phase="shutdown" level="20" type="detach" />
    </device>