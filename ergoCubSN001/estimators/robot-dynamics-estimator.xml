            <param name="frames">(l_foot_front_ft, l_foot_rear_ft, r_foot_rear_ft, r_foot_front_ft)</param>
            <param name="associated_joints">(l_foot_front_ft_sensor, l_foot_rear_ft_sensor, r_foot_rear_ft_sensor, r_foot_front_ft_sensor)</param>
        </group>

        <group name="ACCELEROMETER">
            <param name="names">(waist_imu_0, l_arm_ft_imu, r_arm_ft_imu, l_foot_front_ft_imu, l_foot_rear_ft_imu, r_foot_rear_ft_imu, r_foot_front_ft_imu)</param>
