        <param name="gear_ratio">(100.0, 100.0, -100.0, 100.0, 100.0, 100.0, -100.0, -100.0, -100.0, -100.0, 100.0, -100.0, 160.0, -100.0, -100.0, -100.0, -160.0, 100.0, -160.0, 100.0, 100.0, 100.0, 160.0)</param>
