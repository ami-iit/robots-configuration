<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE devices PUBLIC "-//YARP//DTD yarprobotinterface 3.0//EN" "http://www.yarp.it/DTD/yarprobotinterfaceV3.0.dtd">


<device name="right_foot_rear-FT_secondary_calib" type="ftSecondaryCalibImplNN">
    <param name="period">      0.001      </param> <!-- in seconds -->
    <param name="networkModelPath"> /usr/local/src/robot/robotology-superbuild/src/robots-configuration/ergoCubSN002/estimators/ft_calib_models/r_foot_rear_ft/only_wrench_temperature/batch_normalization/1/onnx/model.onnx </param>
    <param name="numberInputs">     7     </param>  <!-- number of inputs of the network, 13 if all_inputs, or 7 in wrench_temperature-->
    <param name="FtSensorName">r_foot_rear_ft</param>  <!-- name of the FT sensor -->
    <param name="IMUSensorName">r_foot_rear_ft_imu</param>  <!-- name of the IMU sensor -->
    <param name="filter_FT_value"> true </param> <!-- true if you want to filter FT measures using a Butterworth filter -->
    <param name="order"> 2 </param> <!-- order of the Butterworth filter -->
    <param name="cutOffFrequency"> 15 </param> <!-- cutOff Frequency of the Butterworth filter -->
    <param name="isLSTM"> false </param> <!-- true if the network is an LSTM -->
    
    <action phase="startup" level="4" type="attach">
        <paramlist name="networks">
            <!-- ft -->
            <elem name="right_leg-eb7-j4_5-strain_ft1">right_leg-eb7-j4_5-strain</elem>
            <elem name="right_leg-eb7-j4_5-inertial_ft1">right_leg-eb7-j4_5-inertial</elem>
        </paramlist>
    </action>
    <action phase="shutdown" level="20" type="detach" />
</device>
