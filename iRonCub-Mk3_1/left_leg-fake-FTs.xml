<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE devices PUBLIC "-//YARP//DTD yarprobotinterface 3.0//EN" "http://www.yarp.it/DTD/yarprobotinterfaceV3.0.dtd">

<robot name="/fakeRobotFTs" xmlns:xi="http://www.w3.org/2001/XInclude">

    <device xmlns:xi="http://www.w3.org/2001/XInclude" name="fakeFTLeftFootRearDevice" type="fakeFTSensorMAS">
        <param name="sensor_period">      0.002                           </param>
        <param name="name">       l_foot_rear_ft      </param>
    </device>

    <device xmlns:xi="http://www.w3.org/2001/XInclude" name="fakeFTLeftFootFrontDevice" type="fakeFTSensorMAS">
        <param name="sensor_period">      0.002                           </param>
        <param name="name">       l_foot_front_ft      </param>
    </device>

    <device xmlns:xi="http://www.w3.org/2001/XInclude" name="left_leg-FT_remapper" type="multipleanalogsensorsremapper">
        <!-- The below parameter names are set from the macro MAS_getTagFromEnum(enum MAS_SensorType) + "Names"
             defined in <yarp/dev/MultipleAnalogSensorsInterfaces.h> and respective device source file -->
        <param name="SixAxisForceTorqueSensorsNames">
          (l_foot_rear_ft l_foot_front_ft)
        </param>
        <param name="TemperatureSensorsNames">
          (l_foot_rear_ft l_foot_front_ft)
        </param>
        <action phase="startup" level="5" type="attach">
            <paramlist name="networks">
                <elem name="fakeFTLeftFootRearDevice">  fakeFTLeftFootRearDevice </elem>
                <elem name="fakeFTLeftFootFrontDevice">  fakeFTLeftFootFrontDevice </elem>
            </paramlist>
        </action>

        <action phase="shutdown" level="20" type="detach" />
    </device>

    <device xmlns:xi="http://www.w3.org/2001/XInclude" name="left_leg-FT_wrapper" type="multipleanalogsensorsserver">
        <param name="period">      2                           </param>
        <param name="name">       /icub/left_leg/FT       </param>

        <action phase="startup" level="10" type="attach">
            <paramlist name="networks">
                <elem name="left_leg-FT_remapper"> left_leg-FT_remapper </elem>
            </paramlist>
        </action>

        <action phase="shutdown" level="15" type="detach" />
    </device>

</robot>
